# careKind API — 本地开发环境变量示例。复制为 .env 后填写；.env 不提交（.gitignore）。
# 这里只写变量名和非敏感的本地默认值，不写任何真实密钥或密码（change-me-* 只是本地占位，请自己替换）。

# ---- 本地 Postgres（docker-compose.yml 使用；宿主端口 5433）----
POSTGRES_DB=carekind_dev
POSTGRES_USER=carekind_owner
POSTGRES_PASSWORD=change-me-owner

# 迁移、RLS 脚本和种子数据用的连接（表的 owner）。
DATABASE_MIGRATION_URL=postgresql://carekind_owner:change-me-owner@127.0.0.1:5433/carekind_dev
# API 运行时用的连接：prisma/rls.sql 创建的 carekind_app 角色（不是 owner，受 RLS 约束）。
# npm run db:rls 会把 carekind_app 的密码设成 CAREKIND_APP_DB_PASSWORD（两处要一致，不能含单引号）。
CAREKIND_APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://carekind_app:change-me-app@127.0.0.1:5433/carekind_dev

# ---- HTTP ----
PORT=3100
# 允许跨域的前端地址（逗号分隔），例如 Super Admin 的 Vite 开发地址。留空 = 不开 CORS。
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 本地用 http 开发时设为 false；staging / 生产必须为 true。
COOKIE_SECURE=false

# ---- 认证（两个 audience 用不同的密钥，各自至少 32 个字符的随机值，例如 openssl rand -base64 48）----
SUPER_ADMIN_JWT_SECRET=
PORTAL_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_IDLE_TIMEOUT_SECONDS=900
SESSION_MAX_SECONDS=28800

# ---- 邀请链接 ----
PORTAL_INVITE_BASE_URL=http://localhost:5174/accept-invitation
# 只给本地开发用：还没有邮件服务，打开后邀请接口在响应里返回 inviteUrl。生产必须为 false。
DEV_RETURN_INVITE_LINKS=true

# ---- 种子数据（prisma/seed.ts，全部虚构）----
SEED_SUPER_ADMIN_EMAIL=avery.collins@carekind.example
SEED_SUPER_ADMIN_PASSWORD=
# 第二个 Super Admin（可选），用来演练 four-eyes：发起人和批准人必须是两个人。
SEED_SECOND_SUPER_ADMIN_EMAIL=jordan.lee@carekind.example
SEED_SECOND_SUPER_ADMIN_PASSWORD=
# 虚构 Wattle Grove 管理端账号（Helen Tran 等）共用的本地密码；留空 = 这些账号不能登录。
SEED_DEMO_PORTAL_PASSWORD=
