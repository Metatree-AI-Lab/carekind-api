{
	"name": "carekind-api",
	"version": "0.1.0",
	"private": true,
	"description": "careKind API — phase 1 admin back end (Super Admin first)",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"db:up": "docker compose up -d postgres",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev --name init",
		"db:rls": "prisma/apply-rls.sh",
		"db:seed": "tsx --env-file=.env prisma/seed.ts",
		"start:dev": "tsx watch --env-file=.env src/main.ts",
		"start": "tsx --env-file=.env src/main.ts",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@carekind/shared": "file:../shared",
		"@fastify/cookie": "^11.1.3",
		"@nestjs/common": "^11.2.7",
		"@nestjs/core": "^11.2.7",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/platform-fastify": "^11.2.7",
		"@prisma/client": "^6.19.3",
		"argon2": "^0.45.1",
		"fastify": "^5.11.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"eslint": "^9.39.5",
		"prettier": "^3.9.10",
		"prisma": "^6.19.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^3.2.7"
	}
}
